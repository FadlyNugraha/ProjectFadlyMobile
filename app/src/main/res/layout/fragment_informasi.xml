<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/judul_informasi"
        android:textColor="@color/ruangkarya_text"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="18dp" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="14dp"
        app:cardElevation="3dp"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@color/ruangkarya_accent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RuangKarya"
                android:textColor="@color/ruangkarya_text"
                android:textStyle="bold"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="RuangKarya adalah aplikasi penyewaan studio untuk produksi konten dan latihan kreatif. Pilih studio sesuai kebutuhan dan lihat informasi tarif per jam."
                android:textColor="@color/ruangkarya_text"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnHubungiAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Hubungi Admin"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/ruangkarya_primary" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
